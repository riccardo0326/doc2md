/*
  DARE docs site switcher.

  Adds a button to the mdBook menu bar that opens a list of the other
  DARE documentation sites. The list is shared by all sites and lives in a
  single file (sites.json) in the dare/dare repo. If it cannot be loaded, the
  built-in fallback below is used, so the menu always works.

  Self-contained on purpose: to use it in another mdBook, copy this one file
  into its theme/ folder and add it to `additional-js` in book.toml.
*/

var SITE_SWITCHER_URL = "https://gitlab-pages.edag.de/dare/dare/sites.json";
var SITE_SWITCHER_TITLE = "More from DARE";
/* Name of the site this copy lives in, as listed in sites.json. Used when the
   page address does not match (localhost, merge request previews). */
var SITE_SWITCHER_CURRENT = "Kelpie";
var SITE_SWITCHER_FALLBACK = [
  {
    name: "CodeBuddy",
    description: "Set up AI coding tools with the Ephyne gateway",
    url: "https://gitlab-pages.edag.de/dare/codebuddy-config-guide/"
  },
  {
    name: "DARE Blog",
    description: "News and stories from the DARE team",
    url: "https://gitlab-pages.edag.de/dare/dare/"
  },
  {
    name: "Documentation",
    description: "Vise coding guidance and the user manual for our management service",
    url: "https://gitlab-pages.edag.de/dare/documentation/"
  },
  {
    name: "Kelpie",
    description: "Kelpie user manual",
    url: "https://gitlab-pages.edag.de/dare/kelpie/"
  },
  {
    name: "Kelpie SDK",
    description: "Kelpie developer documentation",
    url: "https://gitlab-pages.edag.de/dare/kelpie-sdk/"
  },
  {
    name: "Ragtopus",
    description: "Ragtopus user documentation",
    url: "https://gitlab-pages.edag.de/dare/ragtopus/"
  },
  {
    name: "Ragtopus SDK",
    description: "Ragtopus developer documentation",
    url: "https://gitlab-pages.edag.de/dare/ragtopus-sdk/"
  }
];

(function () {
  "use strict";

  var CSS =
    ".site-switcher-popup{position:absolute;left:10px;top:var(--menu-bar-height);z-index:1000;" +
    "box-sizing:border-box;min-width:260px;max-width:calc(100vw - 20px);margin:0;padding:0;" +
    "font-size:0.85em;color:var(--fg);background:var(--theme-popup-bg);" +
    "border:1px solid var(--theme-popup-border);border-radius:4px;overflow:hidden}" +
    ".site-switcher-popup[hidden]{display:none}" +
    ".site-switcher-heading{margin:0;padding:10px 16px 6px;font-size:0.85em;font-weight:600;" +
    "color:var(--icons)}" +
    ".site-switcher-list{margin:0;padding:0 0 6px;list-style:none}" +
    ".site-switcher-list a{display:block;padding:10px 16px 10px 32px;color:inherit;" +
    "text-decoration:none;line-height:1.35}" +
    ".site-switcher-list a:hover,.site-switcher-list a:focus-visible{background-color:var(--theme-hover)}" +
    ".site-switcher-list a:focus-visible{outline:2px solid var(--links);outline-offset:-2px}" +
    ".site-switcher-name{display:block;font-weight:600}" +
    ".site-switcher-desc{display:block;font-size:0.9em;color:var(--icons)}" +
    ".site-switcher-list a[aria-current]{padding-left:16px}" +
    ".site-switcher-list a[aria-current] .site-switcher-desc{padding-left:16px}" +
    ".site-switcher-list a[aria-current] .site-switcher-name::before{content:\"\\2713\";" +
    "display:inline-block;width:16px}" +
    ".visually-hidden{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;" +
    "clip:rect(0 0 0 0);white-space:nowrap;border:0}" +
    "@media print{#site-switcher-toggle,.site-switcher-popup{display:none}}";

  var GRID_ICON =
    '<span class="fa-svg"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" aria-hidden="true" focusable="false">' +
    '<path d="M32 32h128v128H32zM192 32h128v128H192zM352 32h128v128H352z' +
    "M32 192h128v128H32zM192 192h128v128H192zM352 192h128v128H352z" +
    'M32 352h128v128H32zM192 352h128v128H192zM352 352h128v128H352z"/></svg></span>';

  function isSafeUrl(url) {
    return typeof url === "string" && /^https?:\/\//i.test(url);
  }

  function cleanSites(data) {
    var list = data && data.sites;
    if (!Array.isArray(list)) return null;
    var out = [];
    for (var i = 0; i < list.length; i++) {
      var s = list[i];
      if (s && typeof s.name === "string" && isSafeUrl(s.url)) {
        out.push({
          name: s.name,
          description: typeof s.description === "string" ? s.description : "",
          url: s.url.slice(-1) === "/" ? s.url : s.url + "/"
        });
      }
    }
    out.sort(function (a, b) {
      return a.name.localeCompare(b.name, undefined, { sensitivity: "base" });
    });
    return out.length ? out : null;
  }

  function init() {
    var searchToggle = document.getElementById("mdbook-search-toggle");
    var menuBar = document.getElementById("mdbook-menu-bar");
    if (!searchToggle || !menuBar || document.getElementById("site-switcher-toggle")) return;

    var style = document.createElement("style");
    style.textContent = CSS;
    document.head.appendChild(style);

    /* --- Button --- */
    var button = document.createElement("button");
    button.id = "site-switcher-toggle";
    button.className = "icon-button";
    button.type = "button";
    button.title = SITE_SWITCHER_TITLE;
    button.setAttribute("aria-label", SITE_SWITCHER_TITLE);
    button.setAttribute("aria-expanded", "false");
    button.setAttribute("aria-controls", "site-switcher-menu");
    button.innerHTML = GRID_ICON;
    searchToggle.insertAdjacentElement("afterend", button);

    /* --- Panel (a disclosure containing a navigation list of plain links) --- */
    var panel = document.createElement("nav");
    panel.id = "site-switcher-menu";
    panel.className = "site-switcher-popup";
    panel.setAttribute("aria-labelledby", "site-switcher-heading");
    panel.hidden = true;

    var heading = document.createElement("h2");
    heading.id = "site-switcher-heading";
    heading.className = "site-switcher-heading";
    heading.textContent = SITE_SWITCHER_TITLE;

    var list = document.createElement("ul");
    list.className = "site-switcher-list";

    panel.appendChild(heading);
    panel.appendChild(list);
    menuBar.appendChild(panel);

    function render(sites) {
      list.textContent = "";
      for (var i = 0; i < sites.length; i++) {
        var site = sites[i];
        var li = document.createElement("li");
        var a = document.createElement("a");
        a.href = site.url;

        var name = document.createElement("span");
        name.className = "site-switcher-name";
        name.textContent = site.name;
        a.appendChild(name);

        if (site.description) {
          var desc = document.createElement("span");
          desc.className = "site-switcher-desc";
          desc.textContent = site.description;
          a.appendChild(desc);
        }

        if (location.href.indexOf(site.url) === 0 || site.name === SITE_SWITCHER_CURRENT) {
          a.setAttribute("aria-current", "true");
          var current = document.createElement("span");
          current.className = "visually-hidden";
          current.textContent = " (you are here)";
          name.appendChild(current);
        }

        li.appendChild(a);
        list.appendChild(li);
      }
    }

    render(cleanSites({ sites: SITE_SWITCHER_FALLBACK }));

    /* Upgrade to the shared list when it can be fetched */
    if (window.fetch) {
      fetch(SITE_SWITCHER_URL)
        .then(function (res) {
          if (!res.ok) throw new Error(res.status);
          return res.json();
        })
        .then(function (data) {
          var sites = cleanSites(data);
          if (sites) render(sites);
        })
        .catch(function () {
          /* Keep the fallback list */
        });
    }

    /* --- Open / close --- */
    function isOpen() {
      return !panel.hidden;
    }

    function open() {
      panel.hidden = false;
      button.setAttribute("aria-expanded", "true");
    }

    function close(returnFocus) {
      panel.hidden = true;
      button.setAttribute("aria-expanded", "false");
      if (returnFocus) button.focus();
    }

    function links() {
      return panel.querySelectorAll("a");
    }

    button.addEventListener("click", function () {
      if (isOpen()) {
        close(false);
      } else {
        open();
        var first = links()[0];
        if (first) first.focus();
      }
    });

    /* Arrow keys move through the links; Escape closes and returns focus */
    document.addEventListener("keydown", function (e) {
      if (!isOpen()) return;
      if (e.key === "Escape") {
        e.preventDefault();
        close(true);
        return;
      }
      if (e.key !== "ArrowDown" && e.key !== "ArrowUp") return;
      if (!panel.contains(document.activeElement)) return;
      var items = links();
      var index = Array.prototype.indexOf.call(items, document.activeElement);
      var next = e.key === "ArrowDown" ? index + 1 : index - 1;
      if (next < 0) next = items.length - 1;
      if (next >= items.length) next = 0;
      e.preventDefault();
      items[next].focus();
    });

    /* Close when clicking elsewhere or when keyboard focus leaves the menu */
    document.addEventListener("click", function (e) {
      if (isOpen() && !panel.contains(e.target) && !button.contains(e.target)) close(false);
    });

    panel.addEventListener("focusout", function (e) {
      var to = e.relatedTarget;
      if (to && !panel.contains(to) && to !== button) close(false);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
})();
